[Tests]
  # CPM pytest suite — registered PER FILE (one RavenPython block per
  # test_*.py) so a failure localizes to a single file on the CI dashboard.
  # A single aggregate registration reports only "the CPM suite failed", and on
  # a *timeout* rook kills pytest before its summary prints, so the aggregate
  # form cannot even say which file hung.  Each block runs
  #   python run_cpm_pytests.py <file>
  # i.e. pytest on that one file (see run_cpm_pytests.py).  test_tests_registration.py
  # guards that every test_*.py here has a block, so a newly-added file cannot
  # silently go unrun.  Default max_time (300 s) covers every file; the whole
  # per-PR set runs cold in well under that.

  [./cpm_activity]
    type  = 'RavenPython'
    input = 'run_cpm_pytests.py test_activity.py'
  [../]
  [./cpm_boundary]
    type  = 'RavenPython'
