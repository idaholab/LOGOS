  # ---------------------------------------------------------------------------
  # HEAVY / nightly deep property exploration (NOT run per PR).
  # `heavy = True` gives this block the run type {"heavy"} and drops "normal"
  # (rook Tester.py:417), so it is skipped on the normal per-PR run and executes
  # only under `run_tests --heavy` (main.py:472).  `--thorough` selects the
  # randomized, high-example-count Hypothesis profile (2000 examples, fresh
  # random seed each run) to hunt for new counterexamples off the PR critical
  # path.  A new red here freezes into test_bugfix_regressions.py.  Generous
  # max_time because deep randomized exploration + shrinking can run long.
  # ---------------------------------------------------------------------------
  [./cpm_property_deep]
    type     = 'RavenPython'
    input    = 'run_cpm_pytests.py --thorough test_property_based.py'
    heavy    = True
    max_time = 3600
  [../]
