<Simulation verbosity="debug">
  <TestInfo>
    <name>framework.mckp_optimization</name>
    <author>mandd</author>
    <created>2023-04-13</created>
    <classesTested>Models.ExternalModel.LOGOS.BaseCPMmodel</classesTested>
    <description>
       This test is is designed to check the functionality of the CPM model when
       project schedule is defined from XML nodes
    </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>CPMmodel</WorkingDir>
    <Sequence>simRun</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Models>
    <ExternalModel name="CPMmodel" subType="LOGOS.BaseCPMmodel">
      <variables>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111,end_time</variables>
      <CPtime>end_time</CPtime>
      <schema>outage_schema.json</schema>
      <sgs>max_use_res_ranked</sgs>
      <project_file>example_10.json</project_file>
      <!-- How to automate construction of this mapping block?????-->
      <map act='C101' attr='duration'>R_C101</map>
      <map act='C102' attr='duration'>R_C102</map>
      <map act='C103' attr='duration'>R_C103</map>
      <map act='C104' attr='duration'>R_C104</map>
      <map act='C105' attr='duration'>R_C105</map>
      <map act='C106' attr='duration'>R_C106</map>
      <map act='C107' attr='duration'>R_C107</map>
      <map act='C109' attr='duration'>R_C109</map>
      <map act='C110' attr='duration'>R_C110</map>
      <map act='C111' attr='duration'>R_C111</map>
    </ExternalModel>
  </Models>

  <Distributions>
    <Uniform name="dist_test">
      <lowerBound>8</lowerBound>
      <upperBound>12</upperBound>
    </Uniform>
  </Distributions>

  <Samplers>
    <MonteCarlo name="MC_external">
      <samplerInit>
        <limit>10</limit>
      </samplerInit>
      <variable name="R_C101">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C102">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C103">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C104">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C105">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C106">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C107">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C109">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C110">
        <distribution>dist_test</distribution>
      </variable>
      <variable name="R_C111">
        <distribution>dist_test</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Steps>
    <MultiRun name="simRun">
      <Input   class="DataObjects"  type="PointSet"        >inputPlaceHolder</Input>
      <Model   class="Models"       type="ExternalModel"   >CPMmodel</Model>
      <Sampler class="Samplers"     type="MonteCarlo"      >MC_external</Sampler>
      <Output  class="DataObjects"  type="PointSet"        >sim_PS_map</Output>
      <Output  class="OutStreams"   type="Print"           >Print_sim_PS_map</Output>
    </MultiRun>
  </Steps>

  <OutStreams>
    <Print name="Print_sim_PS_map">
      <type>csv</type>
      <source>sim_PS_map</source>
      <what>input,output</what>
    </Print>
  </OutStreams>

  <DataObjects>
    <PointSet name="inputPlaceHolder">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
    <PointSet name="sim_PS_map">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>end_time,CP</Output>
    </PointSet>
  </DataObjects>

</Simulation>
