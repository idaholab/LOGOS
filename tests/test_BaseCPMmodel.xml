<Simulation verbosity="debug">
  <TestInfo>
    <name>framework.BaseCPMmodel</name>
    <author>mandd</author>
    <created>2023-04-13</created>
    <classesTested>Models.ExternalModel.LOGOS.BaseCPMmodel</classesTested>
    <description>
       This test checks the CPM model when the project schedule is loaded from a
       JSON file and RAVEN samples the activity durations (uncertainty
       propagation). The resource-constrained project duration is returned to
       RAVEN as end_time. This is the minimal duration-sampling deck; see
       test_BaseCPMmodel_map.xml for a larger, resource-rich example.
    </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>CPMmodel</WorkingDir>
    <Sequence>simRun</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Models>
    <ExternalModel name="CPMmodel" subType="LOGOS.BaseCPMmodel">
      <variables>R_A1,R_A2,R_A3,R_A4,R_A5,R_A6,end_time</variables>
      <CPtime>end_time</CPtime>
      <schema>../../src/CPM/outage_schema.json</schema>
      <sgs>max_use_res_ranked</sgs>
      <project_file>test_case_1.json</project_file>
      <map act='A1' attr='duration'>R_A1</map>
      <map act='A2' attr='duration'>R_A2</map>
      <map act='A3' attr='duration'>R_A3</map>
      <map act='A4' attr='duration'>R_A4</map>
      <map act='A5' attr='duration'>R_A5</map>
      <map act='A6' attr='duration'>R_A6</map>
    </ExternalModel>
  </Models>

  <Distributions>
    <Uniform name="dist_dur">
      <lowerBound>4</lowerBound>
      <upperBound>12</upperBound>
    </Uniform>
  </Distributions>

  <Samplers>
    <MonteCarlo name="MC_external">
      <samplerInit>
        <limit>10</limit>
      </samplerInit>
      <variable name="R_A1">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_A2">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_A3">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_A4">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_A5">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_A6">
        <distribution>dist_dur</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Steps>
    <MultiRun name="simRun">
      <Input   class="DataObjects"  type="PointSet"        >inputPlaceHolder</Input>
      <Model   class="Models"       type="ExternalModel"   >CPMmodel</Model>
      <Sampler class="Samplers"     type="MonteCarlo"      >MC_external</Sampler>
      <Output  class="DataObjects"  type="PointSet"        >sim_PS</Output>
      <Output  class="OutStreams"   type="Print"           >Print_sim_PS</Output>
    </MultiRun>
  </Steps>

  <OutStreams>
    <Print name="Print_sim_PS">
      <type>csv</type>
      <source>sim_PS</source>
      <what>input,output</what>
    </Print>
  </OutStreams>

  <DataObjects>
    <PointSet name="inputPlaceHolder">
      <Input>R_A1,R_A2,R_A3,R_A4,R_A5,R_A6</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
    <PointSet name="sim_PS">
      <Input>R_A1,R_A2,R_A3,R_A4,R_A5,R_A6</Input>
      <Output>end_time</Output>
    </PointSet>
  </DataObjects>

</Simulation>
