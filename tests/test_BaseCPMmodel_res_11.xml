<Simulation verbosity="debug">
  <TestInfo>
    <name>framework.BaseCPMmodel_mixed</name>
    <author>mandd</author>
    <created>2023-04-13</created>
    <classesTested>Models.ExternalModel.LOGOS.BaseCPMmodel</classesTested>
    <description>
       This test checks the CPM model in the mixed mode, where RAVEN samples
       both activity durations (uncertainty propagation) and activity priorities
       (scheduling order) in a single realization. Duration and priority maps are
       combined on the same resource-constrained schedule. Two durations are
       returned to RAVEN: end_time (the unconstrained CPM length) and sched_time
       (the resource-constrained makespan, which responds to both the sampled
       durations and priorities).
    </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>CPMmodel</WorkingDir>
    <Sequence>simRun</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Models>
    <ExternalModel name="CPMmodel" subType="LOGOS.BaseCPMmodel">
      <variables>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111,end_time,sched_time</variables>
      <CPtime>end_time</CPtime>
      <scheduled_time>sched_time</scheduled_time>
      <schema>../../src/CPM/outage_schema.json</schema>
      <sgs>max_use_res_ranked</sgs>
      <project_file>example_10.json</project_file>
      <!-- durations sampled for the first five activities ... -->
      <map act='C101' attr='duration'>R_C101</map>
      <map act='C102' attr='duration'>R_C102</map>
      <map act='C103' attr='duration'>R_C103</map>
      <map act='C104' attr='duration'>R_C104</map>
      <map act='C105' attr='duration'>R_C105</map>
      <!-- ... priorities sampled for the remaining five -->
      <map act='C106' attr='priority'>R_C106</map>
      <map act='C107' attr='priority'>R_C107</map>
      <map act='C109' attr='priority'>R_C109</map>
      <map act='C110' attr='priority'>R_C110</map>
      <map act='C111' attr='priority'>R_C111</map>
    </ExternalModel>
  </Models>

  <Distributions>
    <Uniform name="dist_dur">
      <lowerBound>4</lowerBound>
      <upperBound>12</upperBound>
    </Uniform>
    <Uniform name="dist_prio">
      <lowerBound>0</lowerBound>
      <upperBound>1</upperBound>
    </Uniform>
  </Distributions>

  <Samplers>
    <MonteCarlo name="MC_external">
      <samplerInit>
        <limit>10</limit>
      </samplerInit>
      <variable name="R_C101">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_C102">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_C103">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_C104">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_C105">
        <distribution>dist_dur</distribution>
      </variable>
      <variable name="R_C106">
        <distribution>dist_prio</distribution>
      </variable>
      <variable name="R_C107">
        <distribution>dist_prio</distribution>
      </variable>
      <variable name="R_C109">
        <distribution>dist_prio</distribution>
      </variable>
      <variable name="R_C110">
        <distribution>dist_prio</distribution>
      </variable>
      <variable name="R_C111">
        <distribution>dist_prio</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Steps>
    <MultiRun name="simRun">
      <Input   class="DataObjects"  type="PointSet"        >inputPlaceHolder</Input>
      <Model   class="Models"       type="ExternalModel"   >CPMmodel</Model>
      <Sampler class="Samplers"     type="MonteCarlo"      >MC_external</Sampler>
      <Output  class="DataObjects"  type="PointSet"        >sim_PS_mixed</Output>
      <Output  class="OutStreams"   type="Print"           >Print_sim_PS_mixed</Output>
    </MultiRun>
  </Steps>

  <OutStreams>
    <Print name="Print_sim_PS_mixed">
      <type>csv</type>
      <source>sim_PS_mixed</source>
      <what>input,output</what>
    </Print>
  </OutStreams>

  <DataObjects>
    <PointSet name="inputPlaceHolder">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
    <PointSet name="sim_PS_mixed">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>end_time,sched_time</Output>
    </PointSet>
  </DataObjects>

</Simulation>
