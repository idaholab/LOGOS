<Simulation verbosity="debug">
  <TestInfo>
    <name>framework.BaseCPMmodel_GA</name>
    <author>mandd</author>
    <created>2025-12-17</created>
    <classesTested>Models.ExternalModel.LOGOS.BaseCPMmodel</classesTested>
    <description>
       This test checks the CPM model when activity priorities are optimized
       through a Genetic Algorithm workflow: the GA searches the per-activity
       priority values that minimize the resource-constrained project duration
       (end_time) of the schedule loaded from example_10.json.
       NOTE: the interface (project_file / schema / priority maps) is current,
       but run() currently returns getProjectDuration() (the unconstrained CPM
       length), which is INVARIANT to priorities -- so the GA objective is flat
       until run() exposes the resource-constrained makespan (scheduled_duration).
       Both the output quantity and the optimization behavior are to be
       addressed/validated in a RAVEN-enabled environment (see src/CPM/devLogs).
    </description>
  </TestInfo>

  <RunInfo>
    <WorkingDir>CPMmodel</WorkingDir>
    <Sequence>optimize, print</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Models>
    <ExternalModel name="CPMmodel" subType="LOGOS.BaseCPMmodel">
      <variables>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111,end_time</variables>
      <CPtime>end_time</CPtime>
      <schema>outage_schema.json</schema>
      <sgs>max_use_res_ranked</sgs>
      <project_file>example_10.json</project_file>
      <map act='C101' attr='priority'>R_C101</map>
      <map act='C102' attr='priority'>R_C102</map>
      <map act='C103' attr='priority'>R_C103</map>
      <map act='C104' attr='priority'>R_C104</map>
      <map act='C105' attr='priority'>R_C105</map>
      <map act='C106' attr='priority'>R_C106</map>
      <map act='C107' attr='priority'>R_C107</map>
      <map act='C109' attr='priority'>R_C109</map>
      <map act='C110' attr='priority'>R_C110</map>
      <map act='C111' attr='priority'>R_C111</map>
    </ExternalModel>
  </Models>

  <Distributions>
    <Uniform name="dist">
      <lowerBound>0</lowerBound>
      <upperBound>1</upperBound>
    </Uniform>
  </Distributions>

  <Samplers>
    <MonteCarlo name="MC_init">
      <samplerInit>
        <limit>10</limit>
      </samplerInit>
      <variable name="R_C101">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C102">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C103">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C104">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C105">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C106">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C107">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C109">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C110">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C111">
        <distribution>dist</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Steps>
    <MultiRun name="optimize" >
      <Input          class="DataObjects" type="PointSet"         >inputPlaceHolder</Input>
      <Model          class="Models"      type="ExternalModel"    >CPMmodel</Model>
      <Optimizer      class="Optimizers"  type="GeneticAlgorithm" >GAopt</Optimizer>
      <SolutionExport class="DataObjects" type="PointSet"         >opt_export</SolutionExport>
      <Output         class="DataObjects" type="PointSet"         >sim_PS</Output>
    </MultiRun>
    <IOStep name="print">
      <Input  class="DataObjects" type="PointSet" >opt_export</Input>
      <Input  class="DataObjects" type="PointSet" >sim_PS</Input>
      <Output class="OutStreams"  type="Print"    >opt_export</Output>
      <Output class="OutStreams"  type="Print"    >Print_sim_PS</Output>
    </IOStep>
  </Steps>

  <Optimizers>
    <GeneticAlgorithm name="GAopt">
      <samplerInit>
        <limit>5</limit>
        <initialSeed>42</initialSeed>
        <writeSteps>every</writeSteps>
      </samplerInit>

      <GAparams>
        <populationSize>30</populationSize>
        <parentSelection>rouletteWheel</parentSelection>
        <reproduction>
          <crossover type="onePointCrossover">
            <crossoverProb>0.8</crossoverProb>
          </crossover>
          <mutation type="swapMutator">
            <mutationProb>0.9</mutationProb>
          </mutation>
        </reproduction>
        <fitness type="feasibleFirst"></fitness>
        <survivorSelection>fitnessBased</survivorSelection>
      </GAparams>

      <convergence>
        <AHDp>0.0</AHDp>
      </convergence>

      <variable name="R_C101">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C102">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C103">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C104">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C105">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C106">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C107">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C109">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C110">
        <distribution>dist</distribution>
      </variable>
      <variable name="R_C111">
        <distribution>dist</distribution>
      </variable>

      <objective>end_time</objective>
      <TargetEvaluation class="DataObjects" type="PointSet">sim_PS</TargetEvaluation>

    <Sampler    class="Samplers"  type="MonteCarlo" >MC_init</Sampler>
    </GeneticAlgorithm>
  </Optimizers>

  <OutStreams>
    <Print name="Print_sim_PS">
      <type>csv</type>
      <source>sim_PS</source>
      <what>input,output</what>
    </Print>
    <Print name="opt_export">
      <type>csv</type>
      <source>opt_export</source>
    </Print>
  </OutStreams>

  <DataObjects>
    <PointSet name="inputPlaceHolder">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>OutputPlaceHolder</Output>
    </PointSet>
    <PointSet name="sim_PS">
      <Input>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111</Input>
      <Output>end_time</Output>
    </PointSet>
    <PointSet name="opt_export">
      <Input>trajID</Input>
      <Output>R_C101,R_C102,R_C103,R_C104,R_C105,R_C106,R_C107,R_C109,R_C110,R_C111,end_time,
              age,batchId,fitness,iteration,accepted,AHDp,conv_AHDp</Output>
    </PointSet>
  </DataObjects>

</Simulation>
